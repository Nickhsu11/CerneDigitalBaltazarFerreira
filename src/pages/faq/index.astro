---
import Base from "../../layouts/Base.astro";
import { faq, categorias } from "../../data/faq";
const wa = "https://wa.me/351934724284?text=Ol%C3%A1!%20Gostaria%20de%20obter%20mais%20informa%C3%A7%C3%B5es%20sobre%20os%20vossos%20produtos%20e%20servi%C3%A7os%20de%20serigrafia.";
---
<Base title="FAQ Serigrafia | Perguntas Frequentes | Baltazar Ferreira" description="Respostas às perguntas mais frequentes sobre serigrafia em Portugal. Equipamentos, tintas, gravação de quadros, preços e muito mais." canonical="https://baltazarferreira.com/faq">
  <link slot="head" rel="stylesheet" href="/assets/g5.css" />
  <section class="pg-top dots-dark">
    <div class="wrap pg-grid">
     <div>
      <h1>Perguntas Frequentes</h1>
      <p class="lede">Respostas claras para as dúvidas mais comuns sobre serigrafia, produtos e serviços.</p>
      <div class="faq-tools">
        <div class="faq-search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" id="faq-q" placeholder="Pesquisar perguntas" aria-label="Pesquisar perguntas" autocomplete="off" />
        </div>
        <div class="chips" role="group" aria-label="Filtrar por categoria">
          {categorias.map((c, i) => <button type="button" class="chip" data-cat={c} aria-pressed={i === 0 ? "true" : "false"}>{c}</button>)}
        </div>
      </div>
     </div>
     <div class="reg pg-reg">
       <figure><img src="/assets/img/f4cd813b525d318ac20955b9ea0f3b40.webp" alt="Telas serigráficas" width="672" height="512" /></figure>
       <figure><img src="/assets/img/83a92eff4be4a8986e351c0e19f4d076.webp" alt="Rodos profissionais" width="672" height="512" /></figure>
     </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="faq-list" id="faq-list">
        {faq.map((f, i) => (
          <div class="faq-item rv" data-cat={f.cat} style={`--i:${i % 4}`}>
            <h2>
              <button type="button" class="faq-q" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`fa-${i}`} id={`fq-${i}`}>
                <span class="faq-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="t">{f.q}</span>
                <span class="pm" aria-hidden="true">+</span>
              </button>
            </h2>
            <div class="faq-a" id={`fa-${i}`} role="region" aria-labelledby={`fq-${i}`} hidden={i !== 0}>
              <p>{f.a}</p>
              <span class="tag">{f.cat}</span>
            </div>
          </div>
        ))}
        <p class="faq-empty" id="faq-empty" hidden>Nenhuma pergunta encontrada. Tente outra palavra ou escolha «Todos».</p>
      </div>
    </div>
  </section>

  <section class="sec sec-tint">
    <div class="wrap">
      <div class="sec-head"><h2>Três formas de falar connosco</h2></div>
      <div class="cards">
        <div class="card rv"><div class="card-head"><span class="ico"><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.800.6 2.800.7a2 2 0 0 1 1.700 2z"/></svg></span><h3>Telefone</h3></div><p>Ligue para +351 934 724 284.</p><a class="more-link" href="tel:+351934724284">Ligar agora</a></div>
        <div class="card rv" style="--i:1"><div class="card-head"><span class="ico"><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg></span><h3>Email</h3></div><p>Escreva para bferreiralda@gmail.com.</p><a class="more-link" href="mailto:bferreiralda@gmail.com">Enviar email</a></div>
        <div class="card rv" style="--i:2"><div class="card-head"><span class="ico"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><h3>Página de contacto</h3></div><p>Preencha o formulário e respondemos em menos de 24 horas.</p><a class="more-link" href="/contact/">Ir para contacto</a></div>
      </div>
    </div>
  </section>

  <section class="sec cta">
    <div class="wrap">
      <h2>Ainda tens dúvidas?</h2>
      <p style="margin-inline:auto">A nossa equipa está pronta para ajudar. Contacta-nos e respondemos em menos de 24 horas.</p>
      <div class="hero-cta">
        <a class="btn btn-ink" href="/contact/">Contactar Agora</a>
        <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener">Fale connosco</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var items = [].slice.call(document.querySelectorAll(".faq-item"));
      var chips = [].slice.call(document.querySelectorAll(".chip"));
      var input = document.getElementById("faq-q");
      var empty = document.getElementById("faq-empty");
      var cat = "Todos";
      function norm(s) { return s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, ""); }
      function apply() {
        var q = norm(input.value.trim()), n = 0;
        items.forEach(function (it) {
          var ok = (cat === "Todos" || it.dataset.cat === cat) && (!q || norm(it.textContent).indexOf(q) > -1);
          it.hidden = !ok; if (ok) n++;
        });
        empty.hidden = n > 0;
      }
      items.forEach(function (it) {
        var b = it.querySelector(".faq-q"), a = it.querySelector(".faq-a");
        b.addEventListener("click", function () {
          var open = b.getAttribute("aria-expanded") === "true";
          b.setAttribute("aria-expanded", open ? "false" : "true"); a.hidden = open;
        });
      });
      chips.forEach(function (c) {
        c.addEventListener("click", function () {
          cat = c.dataset.cat;
          chips.forEach(function (x) { x.setAttribute("aria-pressed", x === c ? "true" : "false"); });
          apply();
        });
      });
      input.addEventListener("input", apply);
    })();
  </script>
</Base>
