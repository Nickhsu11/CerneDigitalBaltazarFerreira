---
import Base from "../../layouts/Base.astro";
const wa = "https://wa.me/351934724284?text=Ol%C3%A1!%20Gostaria%20de%20obter%20mais%20informa%C3%A7%C3%B5es%20sobre%20os%20vossos%20produtos%20e%20servi%C3%A7os%20de%20serigrafia.";
const img = (h: string) => `/assets/img/${h}.webp`;
const emu = img("f20b694487fbdc0b9294ca5652470ed5"), rod = img("83a92eff4be4a8986e351c0e19f4d076"),
  tel = img("f4cd813b525d318ac20955b9ea0f3b40"), tin = img("723694ad9521a024a376a5e50bbb878a");
const valores = [
  { t: "Precisão", d: "Cada detalhe conta na serigrafia. Entregamos resultados precisos que cumprem os mais elevados padrões técnicos.", i: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" },
  { t: "Fiabilidade", d: "Qualidade consistente e serviço de confiança são a base de parcerias duradouras com os nossos clientes.", i: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4" },
  { t: "Parceria", d: "Construímos relações duradouras com os nossos clientes, oferecendo suporte contínuo e conhecimento especializado para o seu sucesso.", i: "M11 17l2 2a1 1 0 1 0 3-3M14 14l2.5 2.5a1 1 0 1 0 3-3l-3.9-3.9a3 3 0 0 0-4.2 0l-.9.9a1.5 1.5 0 0 1-2.1 0 1.5 1.5 0 0 0-2.1 0L2 13M2 12l6 6" },
];
---
<Base
  title="Sobre Nós — Especialistas em Serigrafia | Baltazar Ferreira"
  description="Conheça a Baltazar Ferreira, empresa especializada em serigrafia com mais de 25 anos de experiência ao serviço de clientes nacionais e internacionais em Portugal e Europa."
  canonical="https://baltazarferreira.com/about"
>
  <link slot="head" rel="stylesheet" href="/assets/g2.css" />
  <section class="hero slim">
    <div class="wrap">
      <div>
        <h1>Sobre Nós</h1>
        <p class="lede">Precisão, Fiabilidade, Parceria</p>
      </div>
      <div class="reg">
        <figure><img src={emu} alt="Emulsões profissionais" width="672" height="512" /></figure>
        <figure><img src={tel} alt="Telas serigráficas" loading="lazy" width="672" height="512" /></figure>
        <figure><img src={rod} alt="Rodos profissionais" loading="lazy" width="672" height="512" /></figure>
        <figure><img src={tin} alt="Tintas serigráficas" loading="lazy" width="672" height="512" /></figure>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap about">
      <div class="rv">
        <h2>Precisão, Fiabilidade, Parceria</h2>
        <p class="lead">Com anos de experiência técnica, oferecemos soluções completas que combinam qualidade, precisão e fiabilidade para empresas, exemplo disto são os projetos realizados para empresas no setor industrial, incluindo multinacionais.</p>
        <details class="more">
          <summary>Ler mais</summary>
          <div class="more-body">
            <p>A Baltazar Ferreira é uma empresa familiar especializada em serviços de apoio à serigrafia e fornecimento de produtos profissionais para o setor.</p>
            <p>O nosso compromisso é estabelecer parcerias de longo prazo, fornecendo suporte técnico especializado e produtos que cumprem os mais elevados padrões europeus de produção.</p>
          </div>
        </details>
      </div>
      <div class="stats">
        <div class="stat rv" style="--i:1"><span class="num" data-count="25" data-suffix="+">25+</span><p>Anos de Experiência</p></div>
        <div class="stat rv" style="--i:2"><h3>Clientes</h3><p>Vasto número de clientes no setor serigráfico industrial e têxtil.</p></div>
        <div class="stat rv" style="--i:3"><span class="num" data-count="8">8</span><p>Categorias de Produtos</p></div>
        <div class="stat rv" style="--i:4"><span class="num" data-count="5">5</span><p>Tipos de Serviços</p></div>
      </div>
    </div>
  </section>

  <section class="sec sec-tint">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow">Princípios</span>
        <h2>Os Nossos Valores</h2>
      </div>
      <div class="cards values">
        {valores.map((v, k) => (
          <article class="card value rv" style={`--i:${k}`}>
            <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={v.i} /></svg></span>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-ink dots">
    <div class="wrap about-pt">
      <div class="about-img rv"><img src={tin} alt="Tintas serigráficas" loading="lazy" width="672" height="512" /></div>
      <div class="rv" style="--i:1">
        <p class="quote">Parcerias de longo prazo, com suporte técnico especializado.</p>
      </div>
    </div>
  </section>

  <section class="sec cta">
    <div class="wrap rv">
      <h2>Pronto para Iniciar o Seu Projeto?</h2>
      <div class="hero-cta">
        <a class="btn btn-ink" href="/contact/">Contactar a Nossa Equipa</a>
        <a class="btn btn-ghost" href={wa}>Fale connosco</a>
      </div>
    </div>
  </section>
</Base>
