---
import Base from "../../layouts/Base.astro";
const wa = "https://wa.me/351934724284?text=Ol%C3%A1!%20Gostaria%20de%20obter%20mais%20informa%C3%A7%C3%B5es%20sobre%20os%20vossos%20produtos%20e%20servi%C3%A7os%20de%20serigrafia.";
---
<Base title="Carrinho de Compras | Baltazar Ferreira" description="Reveja os produtos selecionados e solicite um orçamento de produtos de serigrafia à Baltazar Ferreira." canonical="https://baltazarferreira.com/cart">
  <link slot="head" rel="stylesheet" href="/assets/g5.css" />
  <section class="pg-top dots-dark">
    <div class="wrap pg-grid">
      <div>
        <h1>Carrinho de Compras</h1>
        <p class="lede">Reveja os produtos selecionados e solicite o seu orçamento</p>
      </div>
      <div class="reg pg-reg">
        <figure><img src="/assets/img/f20b694487fbdc0b9294ca5652470ed5.webp" alt="Emulsões profissionais" width="672" height="512" /></figure>
        <figure><img src="/assets/img/723694ad9521a024a376a5e50bbb878a.webp" alt="Tintas serigráficas" width="672" height="512" /></figure>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="cart-empty rv" id="cart-empty">
        <div class="ico-big" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg></div>
        <h2>O seu carrinho está vazio</h2>
        <p>Adicione produtos ao carrinho para solicitar um orçamento</p>
        <div class="hero-cta">
          <a class="btn btn-accent" href="/products/">Ver Produtos</a>
          <a class="btn btn-ink" href={wa} target="_blank" rel="noopener">Fale connosco</a>
        </div>
      </div>

      <div class="cart-grid has-items" id="cart-full" hidden>
        <div>
          <h2>Os seus produtos</h2>
          <div class="cart-lines" id="cart-lines"></div>
          <p class="cart-more"><a class="btn btn-ghost btn-sm" style="color:var(--ink)" href="/products/">Continuar a comprar</a></p>
        </div>
        <div class="cart-side">
          <form class="quote" id="quote" novalidate>
            <h2>Solicitar Orçamento</h2>
            <ul class="sum" id="quote-sum" aria-label="Produtos do pedido"></ul>
            <div class="fld">
              <label for="q-name">Nome *</label>
              <input id="q-name" name="nome" type="text" required autocomplete="name" aria-describedby="e-name" />
              <span class="err" id="e-name" aria-live="polite"></span>
            </div>
            <div class="fld">
              <label for="q-mail">Email *</label>
              <input id="q-mail" name="email" type="email" required autocomplete="email" aria-describedby="e-mail" />
              <span class="err" id="e-mail" aria-live="polite"></span>
            </div>
            <div class="fld">
              <label for="q-msg">Mensagem (opcional)</label>
              <textarea id="q-msg" name="mensagem" rows="4"></textarea>
            </div>
            <button class="btn btn-accent" type="submit">Solicitar Orçamento</button>
            <p class="notice" id="q-note" role="status" hidden style="margin-top:1rem">Dados validados. O envio do pedido ainda não está ligado: nada foi enviado. Entretanto, contacte-nos por email, telefone ou WhatsApp.</p>
          </form>
          <a class="btn btn-ink" href={wa} target="_blank" rel="noopener">Fale connosco</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-tint">
    <div class="wrap">
      <div class="sec-head"><h2>Como funciona</h2></div>
      <div class="cards">
        <div class="card rv"><div class="card-head"><span class="ico"><svg viewBox="0 0 24 24"><path d="m7.5 4.3 9 5.2M21 8v8l-9 5-9-5V8l9-5z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/></svg></span><h3>1. Escolha</h3></div><p>Adicione produtos ao carrinho a partir do catálogo.</p></div>
        <div class="card rv" style="--i:1"><div class="card-head"><span class="ico"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><h3>2. Quantidades</h3></div><p>Ajuste as quantidades ou remova o que não precisa.</p></div>
        <div class="card rv" style="--i:2"><div class="card-head"><span class="ico"><svg viewBox="0 0 24 24"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg></span><h3>3. Peça orçamento</h3></div><p>Indique nome e email e responderemos em menos de 24 horas.</p></div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var lines = document.getElementById("cart-lines"), full = document.getElementById("cart-full"),
          empty = document.getElementById("cart-empty"), sum = document.getElementById("quote-sum");
      function esc(s) { var d = document.createElement("div"); d.textContent = s == null ? "" : String(s); return d.innerHTML; }
      function setQty(id, q) {
        var l = window.Carrinho.get();
        l.forEach(function (i) { if (i.id === id) i.quantity = q; });
        try { localStorage.setItem("carrinho", JSON.stringify(l)); } catch (e) {}
        window.Carrinho.remove("\u0000"); // dispara atualização do contador e do evento
      }
      function render() {
        var l = window.Carrinho.get();
        full.hidden = l.length === 0; empty.hidden = l.length > 0;
        lines.innerHTML = l.map(function (i) {
          var img = i.image ? '<img src="' + esc(i.image) + '" alt="" loading="lazy">' : '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7.5 4.3 9 5.2M21 8v8l-9 5-9-5V8l9-5z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/></svg>';
          return '<article class="line" data-id="' + esc(i.id) + '"><div class="thumb">' + img + '</div><div><h3>' + esc(i.name) + '</h3><p>' + esc(i.description) + '</p></div>' +
            '<div class="line-act"><div class="qty" role="group" aria-label="Quantidade de ' + esc(i.name) + '"><button type="button" data-d="-1" aria-label="Diminuir quantidade">&minus;</button><output aria-live="polite">' + (Number(i.quantity) || 1) + '</output><button type="button" data-d="1" aria-label="Aumentar quantidade">+</button></div>' +
            '<button type="button" class="rm" data-rm>Remover</button></div></article>';
        }).join("");
        sum.innerHTML = l.map(function (i) { return "<li>" + esc(i.name) + " &times; " + (Number(i.quantity) || 1) + "</li>"; }).join("");
      }
      lines.addEventListener("click", function (e) {
        var row = e.target.closest(".line"); if (!row) return;
        var id = row.dataset.id;
        if (e.target.closest("[data-rm]")) { window.Carrinho.remove(id); return; }
        var b = e.target.closest("[data-d]"); if (!b) return;
        var it = window.Carrinho.get().filter(function (i) { return i.id === id; })[0]; if (!it) return;
        var q = (Number(it.quantity) || 1) + Number(b.dataset.d);
        if (q < 1) q = 1;
        setQty(id, q);
      });
      document.addEventListener("carrinho:change", render);
      var f = document.getElementById("quote"), note = document.getElementById("q-note");
      f.addEventListener("submit", function (e) {
        e.preventDefault();
        var n = document.getElementById("q-name"), m = document.getElementById("q-mail"), ok = true;
        var en = document.getElementById("e-name"), em = document.getElementById("e-mail");
        en.textContent = ""; em.textContent = ""; n.removeAttribute("aria-invalid"); m.removeAttribute("aria-invalid");
        if (!n.value.trim()) { en.textContent = "Indique o seu nome."; n.setAttribute("aria-invalid", "true"); ok = false; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(m.value.trim())) { em.textContent = "Indique um email válido."; m.setAttribute("aria-invalid", "true"); ok = false; }
        note.hidden = !ok;
        if (!ok) (n.getAttribute("aria-invalid") ? n : m).focus();
      });
      if (window.Carrinho) render(); else document.addEventListener("DOMContentLoaded", render);
    })();
  </script>
</Base>
