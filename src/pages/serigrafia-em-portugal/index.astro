---
import Base from "../../layouts/Base.astro";
const wa = "https://wa.me/351934724284?text=Ol%C3%A1!%20Gostaria%20de%20obter%20mais%20informa%C3%A7%C3%B5es%20sobre%20os%20vossos%20produtos%20e%20servi%C3%A7os%20de%20serigrafia.";
const svg = (p: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${p}</svg>`;
const servicos = [
  ["Gravação de Quadros", "Serviço profissional de gravação de quadros serigráficos com alta precisão milimétrica e tecnologia avançada, disponível para empresas de serigrafia em todo Portugal.", "https://baltazarferreira.com/services/gravacao-de-quadros", '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/>'],
  ["Criação de Fotolitos", "Fotolitos de máxima resolução e opacidade, criados com película transparente de alta qualidade para resultados perfeitos em cada impressão serigráfica.", "https://baltazarferreira.com/services/criacao-de-fotolitos", '<rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>'],
  ["Quadros de Alumínio", "Fabricação de quadros de alumínio de alta durabilidade e engenharia de precisão, com tamanhos personalizados e standard para todas as necessidades de serigrafia.", "https://baltazarferreira.com/services/quadros-de-aluminio", '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/>'],
  ["Emulsionamento Profissional", "Aplicação uniforme de emulsão fotossensível de grau profissional, garantindo controlo consistente de espessura e resultados de qualidade superior.", "https://baltazarferreira.com/services/emulsionamento-profissional", '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>'],
  ["Serviços de Impressão", "Impressão serigráfica de excelência sobre múltiplos materiais, com cores vibrantes e processos fiáveis e repetíveis para produção industrial.", "https://baltazarferreira.com/services/servicos-de-impressao", '<path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/>'],
  ["Envio para Toda a Europa", "Entrega rápida e segura de produtos e quadros gravados para clientes em Portugal, Espanha, França, Alemanha e resto da União Europeia.", "/contact/", '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>'],
];
const cidades = ["Lisboa","Porto","Coimbra","Braga","Setúbal","Aveiro","Leiria","Faro","Évora","Guarda","Viseu","Bragança","Castelo Branco","Portalegre","Santarém","Viana do Castelo","Vila Real"];
const faq = [
  ["O que é serigrafia?", "A serigrafia é uma técnica de impressão industrial que utiliza uma tela esticada num quadro para transferir tinta sobre diversos materiais como têxteis, plástico, metal, vidro e papel. Em Portugal, a serigrafia é amplamente utilizada na indústria têxtil, publicidade, cerâmica e sinalização."],
  ["Quais serviços de serigrafia existem em Portugal?", "Em Portugal, os principais serviços de serigrafia incluem gravação de quadros serigráficos, criação de fotolitos, fabricação de quadros de alumínio, emulsionamento profissional e serviços de impressão serigráfica. A Baltazar Ferreira oferece todos estes serviços com qualidade superior para clientes em Portugal e Europa."],
  ["Quais produtos de serigrafia são mais utilizados em Portugal?", "Os produtos de serigrafia mais utilizados em Portugal incluem emulsões diazo, tintas serigráficas para têxteis e outros materiais, telas serigráficas em poliéster, borrachas e rodos de impressão, químicos de limpeza como desengordurantes e solventes, e acessórios técnicos como colas e panos de limpeza."],
  ["Onde posso encontrar serigrafia de qualidade em Portugal?", "A Baltazar Ferreira, sediada em Fanqueiro, Loures, é especialista em serigrafia em Portugal com mais de 25 anos de experiência. Oferecemos serviços e produtos premium para empresas serigráficas em todo o país, incluindo Lisboa, Porto, Coimbra, Braga, Setúbal e Aveiro."],
  ["A serigrafia em Portugal é um bom negócio?", "Sim, a serigrafia em Portugal é um setor em crescimento, particularmente nas áreas têxtil, publicitária, cerâmica e decoração. Com o aumento da procura por produtos personalizados e branding corporativo, o mercado de serigrafia em Portugal oferece excelentes oportunidades para empresas que investem em qualidade e tecnologia."],
  ["Quanto custa a gravação de um quadro de serigrafia em Portugal?", "O custo da gravação de um quadro de serigrafia em Portugal depende do tamanho, da complexidade do design e da quantidade de quadros. A Baltazar Ferreira oferece orçamentos personalizados e competitivos para todas as necessidades. Contacte-nos para obter um preço à medida do seu projeto."],
  ["Quais são as melhores tintas serigráficas para têxteis em Portugal?", "As melhores tintas serigráficas para têxteis em Portugal são as que oferecem máxima aderência, durabilidade lavável e cores vibrantes. A Baltazar Ferreira fornece tintas de alta qualidade específicas para impressão têxtil, com excelente cobertura e resistência ao desgaste e lavagem repetida."],
  ["A Baltazar Ferreira envia produtos para fora de Portugal?", "Sim, além de Portugal, a Baltazar Ferreira envia produtos de serigrafia e serviços de gravação de quadros para toda a Europa, incluindo Espanha, França, Alemanha, Itália e outros países da União Europeia."],
];
---
<Base title="Serigrafia em Portugal — Serviços e Produtos de Qualidade | Baltazar Ferreira" description="A melhor serigrafia em Portugal. Baltazar Ferreira oferece serviços profissionais de serigrafia em Portugal e toda a Europa: gravação de quadros, fotolitos, emulsionamento, tintas, telas e consumíveis premium para empresas serigráficas portuguesas." canonical="https://baltazarferreira.com/serigrafia-em-portugal">
  <link slot="head" rel="stylesheet" href="/assets/g4.css" />
  <main id="conteudo">
    <section class="hero hero-sm">
      <div class="wrap">
        <div>
          <h1>Serigrafia em Portugal</h1>
          <p class="lede">Serviços profissionais de serigrafia e produtos premium para empresas em todo Portugal e Europa. Qualidade superior, precisão técnica e parceria de confiança há mais de 25 anos.</p>
          <div class="hero-cta">
            <a class="btn btn-accent" href="/contact/">Contactar Agora</a>
            <a class="btn btn-ghost" href="/products/">Ver Catálogo de Produtos</a>
          </div>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap split">
        <div>
          <span class="eyebrow">Guia Completo</span>
          <h2 class="rv">O que é Serigrafia?</h2>
          <p class="rv" style="font-size:1.2rem;color:var(--ink)">A serigrafia é uma técnica de impressão industrial milenar que permite transferir tinta sobre diversos materiais através de uma tela esticada num quadro metálico ou de madeira. Em Portugal, a serigrafia é uma das indústrias mais relevantes no setor têxtil, publicitário, cerâmico e de decoração.</p>
          <details class="more rv">
            <summary>Ler mais</summary>
            <div class="more-body">
              <p>O processo envolve a criação de uma imagem na tela — através de fotolitos e emulsão fotossensível — que bloqueia as áreas que não devem receber tinta. A tinta é então forçada através das malhas abertas com um rodo de borracha, criando a impressão com precisão e durabilidade.</p>
              <p>A serigrafia em Portugal evoluiu significativamente nos últimos anos, com empresas como a Baltazar Ferreira a oferecerem serviços de alta precisão e consumíveis de qualidade profissional para toda a indústria serigráfica nacional.</p>
            </div>
          </details>
        </div>
        <div class="pic rv"><img src="/assets/img/a3ea9f3acd5ee2fdb5ef0e020a9fc63f.webp" alt="Oficina profissional de serigrafia em Portugal com equipamento moderno" width="640" height="480" loading="lazy" /><span class="sticker">Em Todo o País</span></div>
      </div>
    </section>

    <section class="sec sec-tint">
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">Serviços</span>
          <h2>Serviços de Serigrafia em Portugal</h2>
          <p>A Baltazar Ferreira oferece serviços completos de serigrafia para empresas em Portugal e Europa, com qualidade superior e atenção a cada detalhe.</p>
        </div>
        <div class="cards svc">
          {servicos.map(([t, d, l, ic], i) => (
            <div class="card rv" style={`--i:${i % 3}`}>
              <div class="card-head"><span class="ico"><Fragment set:html={svg(ic)} /></span><h3>{t}</h3></div>
              <p>{d}</p>
              <a class="more-link" href={l}>Saber mais</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap split flip">
        <div>
          <span class="eyebrow">Catálogo Completo</span>
          <h2 class="rv">Produtos de Serigrafia em Portugal</h2>
          <p class="rv">Dispomos de uma vasta gama de produtos de serigrafia para empresas em Portugal. Desde emulsões diazo e fotopoliméricas até tintas serigráficas para têxteis, plástico, papel e metal — todos os consumíveis necessários para produção serigráfica profissional.</p>
          <div class="stats num-band">
            <div class="stat rv"><span class="num" data-count="21" data-suffix="Y">21Y</span><p>Início da gama de telas serigráficas em poliéster.</p></div>
            <div class="stat rv" style="--i:1"><span class="num" data-count="165" data-suffix="T">165T</span><p>Fim da gama de telas serigráficas em poliéster.</p></div>
          </div>
          <p class="rv" style="margin-top:1.4rem">Os nossos telas serigráficas em poliéster (desde 21Y até 165T) são reconhecidas pela durabilidade e precisão. Complementamos com borrachas e rodos de impressão, químicos de limpeza como acetona e desengordurantes, tira fantasmas, abridores de telas e diversos acessórios técnicos.</p>
          <p class="rv">Todos os produtos cumprem os mais elevados padrões europeus de qualidade e são distribuídos em Portugal com rapidez e eficiência. Entre em contacto connosco para obter o seu orçamento personalizado.</p>
          <a class="btn btn-ink rv" href="/products/">Ver Catálogo de Produtos</a>
        </div>
        <div class="pic rv"><img src="/assets/img/df5fd95763bed743ab42129c91587c04.webp" alt="Produtos de serigrafia premium disponíveis em Portugal" width="640" height="480" loading="lazy" /></div>
      </div>
    </section>

    <section class="sec sec-ink dots">
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">Toda a Portugal</span>
          <h2>Servimos Toda Portugal</h2>
          <p>A Baltazar Ferreira fornece serviços e produtos de serigrafia em todas as regiões de Portugal, de norte a sul, incluindo as ilhas.</p>
        </div>
        <ul class="cities rv">{cidades.map((c) => <li>{c}</li>)}</ul>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">Perguntas Frequentes</span>
          <h2>Tudo Sobre Serigrafia em Portugal</h2>
        </div>
        <div class="faq">
          {faq.map(([q, a], i) => (
            <details class="rv" style={`--i:${i % 3}`}><summary><h3 style="margin:0;font-size:inherit">{q}</h3></summary><p>{a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="sec cta">
      <div class="wrap rv">
        <h2>Pronto para Iniciar o Seu Projeto de Serigrafia?</h2>
        <p style="margin-inline:auto">Peça o seu orçamento gratuito. Atendemos empresas em Portugal e toda a Europa.</p>
        <div class="hero-cta">
          <a class="btn btn-ink" href="/contact/">Contactar Agora</a>
          <a class="btn btn-ghost" href={wa} rel="noopener">Fale connosco</a>
        </div>
      </div>
    </section>
  </main>
</Base>
