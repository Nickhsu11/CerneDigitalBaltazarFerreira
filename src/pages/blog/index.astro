---
import Base from "../../layouts/Base.astro";
import { artigos, etiquetas, localImg, dataPt, href, icon } from "../../data/blog";
const wa = "https://wa.me/351934724284?text=Ol%C3%A1!%20Gostaria%20de%20obter%20mais%20informa%C3%A7%C3%B5es%20sobre%20os%20vossos%20produtos%20e%20servi%C3%A7os%20de%20serigrafia.";
const lista = artigos.map((a) => ({ ...a, local: localImg(a.img) }));
const usadas = [...new Set(artigos.flatMap((a) => a.tags))];
---
<Base title="Blog de Serigrafia | Dicas, Guias e Notícias | Baltazar Ferreira" description="Blog especializado em serigrafia em Portugal. Guias, dicas, tutoriais e notícias sobre equipamentos, tintas, técnicas e negócios de serigrafia." canonical="https://baltazarferreira.com/blog">
  <link slot="head" rel="stylesheet" href="/assets/g4.css" />
  <main id="conteudo">
    <section class="hero hero-sm">
      <div class="wrap">
        <div>
          <h1>Blog de Serigrafia</h1>
          <p class="lede">Guias, dicas e notícias sobre serigrafia em Portugal. Tudo o que precisas saber para dominar esta arte.</p>
          <ul class="hero-badges" aria-label="Resumo do blog">
            <li>{artigos.length} artigos</li><li>Para iniciantes e profissionais</li><li>Tratamento por «tu»</li>
          </ul>
        </div>
        <div class="reg hero-pics" aria-hidden="true">
          <figure><img src="/assets/img/a3ea9f3acd5ee2fdb5ef0e020a9fc63f.webp" alt="" width="300" height="300" /></figure>
          <figure><img src="/assets/img/df5fd95763bed743ab42129c91587c04.webp" alt="" width="300" height="300" /></figure>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">Artigos</span>
          <h2>Escolhe um tema e começa a ler</h2>
        </div>
        <ul class="filters rv" id="filtros" aria-label="Filtrar por etiqueta">
          <li><button class="chip" type="button" data-tag="todos" aria-pressed="true">Todos</button></li>
          {usadas.map((t) => <li><button class="chip" type="button" data-tag={t} aria-pressed="false">{etiquetas[t]}</button></li>)}
        </ul>
        <div class="posts" id="posts">
          {lista.map((a, i) => (
            <article class={"post rv" + (a.pagina ? " first" : "")} style={`--i:${i % 3}`} data-tags={a.tags.join(" ")}>
              {a.local
                ? <div class="post-img"><img src={a.local} alt={a.titulo} width="640" height="400" loading="lazy" /></div>
                : <div class="post-img ph" aria-hidden="true"><Fragment set:html={icon("layers")} /></div>}
              <div class="post-body">
                <div class="post-meta">
                  <span><Fragment set:html={icon("cal")} /><time datetime={a.data}>{dataPt(a.data)}</time></span>
                  <span><Fragment set:html={icon("clock")} />{a.min} min</span>
                </div>
                <h2><a href={href(a)}>{a.titulo}</a></h2>
                <p>{a.resumo}</p>
                <ul class="tags">{a.tags.map((t) => <li>{etiquetas[t]}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
        <p class="empty" id="vazio" hidden>Sem artigos com esta etiqueta.</p>
      </div>
    </section>

    <section class="sec sec-tint">
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">Ordem de leitura</span>
          <h2>Do primeiro quadro ao negócio</h2>
        </div>
        <ol class="timeline rv">
          {artigos.map((a) => <li><div><b><a href={href(a)}>{a.titulo}</a></b><p>{a.min} min de leitura · {dataPt(a.data)}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="sec cta">
      <div class="wrap rv">
        <h2>Queres Aprender Mais sobre Serigrafia?</h2>
        <p style="margin-inline:auto">Visita a nossa página de serviços e descobre como a Baltazar Ferreira pode ajudar o teu negócio ou projeto de serigrafia.</p>
        <div class="hero-cta">
          <a class="btn btn-ink" href="/services/">Ver Serviços</a>
          <a class="btn btn-ghost" href="/contact/">Falar Connosco</a>
          <a class="btn btn-ghost" href={wa} rel="noopener">Fale connosco</a>
        </div>
      </div>
    </section>
  </main>
  <script is:inline>
    (function () {
      var bar = document.getElementById("filtros"); if (!bar) return;
      var posts = document.querySelectorAll("#posts .post"), vazio = document.getElementById("vazio");
      bar.addEventListener("click", function (e) {
        var b = e.target.closest(".chip"); if (!b) return;
        var t = b.getAttribute("data-tag"), n = 0;
        bar.querySelectorAll(".chip").forEach(function (c) { c.setAttribute("aria-pressed", c === b ? "true" : "false"); });
        posts.forEach(function (p) {
          var ok = t === "todos" || (" " + p.getAttribute("data-tags") + " ").indexOf(" " + t + " ") > -1;
          p.hidden = !ok; if (ok) { n++; p.classList.add("in"); }
        });
        vazio.hidden = n > 0;
      });
    })();
  </script>
</Base>
